<?xml version="1.0" encoding="UTF-8"?>
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry"
                    xmlns:xs="http://www.w3.org/2001/XMLSchema"
                    oor:name="Addons" oor:package="org.openoffice.Office">
  <node oor:name="AddonUI">

    <!-- ================= Command icons ================= -->
    <node oor:name="Images">
      <node oor:name="io.github.rokusaburo.hailper.image.chat" oor:op="replace">
        <prop oor:name="URL" oor:type="xs:string">
          <value>io.github.rokusaburo.hailper:chat</value>
        </prop>
        <node oor:name="UserDefinedImages">
          <prop oor:name="ImageSmallURL" oor:type="xs:string">
            <value>vnd.sun.star.extension://io.github.rokusaburo.hailper/icons/chat-16.png</value>
          </prop>
          <prop oor:name="ImageBigURL" oor:type="xs:string">
            <value>vnd.sun.star.extension://io.github.rokusaburo.hailper/icons/chat-26.png</value>
          </prop>
        </node>
      </node>
      <node oor:name="io.github.rokusaburo.hailper.image.summarize" oor:op="replace">
        <prop oor:name="URL" oor:type="xs:string">
          <value>io.github.rokusaburo.hailper:summarize</value>
        </prop>
        <node oor:name="UserDefinedImages">
          <prop oor:name="ImageSmallURL" oor:type="xs:string">
            <value>vnd.sun.star.extension://io.github.rokusaburo.hailper/icons/summarize-16.png</value>
          </prop>
          <prop oor:name="ImageBigURL" oor:type="xs:string">
            <value>vnd.sun.star.extension://io.github.rokusaburo.hailper/icons/summarize-26.png</value>
          </prop>
        </node>
      </node>
      <node oor:name="io.github.rokusaburo.hailper.image.rewrite" oor:op="replace">
        <prop oor:name="URL" oor:type="xs:string">
          <value>io.github.rokusaburo.hailper:rewrite</value>
        </prop>
        <node oor:name="UserDefinedImages">
          <prop oor:name="ImageSmallURL" oor:type="xs:string">
            <value>vnd.sun.star.extension://io.github.rokusaburo.hailper/icons/rewrite-16.png</value>
          </prop>
          <prop oor:name="ImageBigURL" oor:type="xs:string">
            <value>vnd.sun.star.extension://io.github.rokusaburo.hailper/icons/rewrite-26.png</value>
          </prop>
        </node>
      </node>
      <node oor:name="io.github.rokusaburo.hailper.image.continue" oor:op="replace">
        <prop oor:name="URL" oor:type="xs:string">
          <value>io.github.rokusaburo.hailper:continue</value>
        </prop>
        <node oor:name="UserDefinedImages">
          <prop oor:name="ImageSmallURL" oor:type="xs:string">
            <value>vnd.sun.star.extension://io.github.rokusaburo.hailper/icons/continue-16.png</value>
          </prop>
          <prop oor:name="ImageBigURL" oor:type="xs:string">
            <value>vnd.sun.star.extension://io.github.rokusaburo.hailper/icons/continue-26.png</value>
          </prop>
        </node>
      </node>
      <node oor:name="io.github.rokusaburo.hailper.image.translate" oor:op="replace">
        <prop oor:name="URL" oor:type="xs:string">
          <value>io.github.rokusaburo.hailper:translate</value>
        </prop>
        <node oor:name="UserDefinedImages">
          <prop oor:name="ImageSmallURL" oor:type="xs:string">
            <value>vnd.sun.star.extension://io.github.rokusaburo.hailper/icons/translate-16.png</value>
          </prop>
          <prop oor:name="ImageBigURL" oor:type="xs:string">
            <value>vnd.sun.star.extension://io.github.rokusaburo.hailper/icons/translate-26.png</value>
          </prop>
        </node>
      </node>
      <node oor:name="io.github.rokusaburo.hailper.image.proofread" oor:op="replace">
        <prop oor:name="URL" oor:type="xs:string">
          <value>io.github.rokusaburo.hailper:proofread</value>
        </prop>
        <node oor:name="UserDefinedImages">
          <prop oor:name="ImageSmallURL" oor:type="xs:string">
            <value>vnd.sun.star.extension://io.github.rokusaburo.hailper/icons/proofread-16.png</value>
          </prop>
          <prop oor:name="ImageBigURL" oor:type="xs:string">
            <value>vnd.sun.star.extension://io.github.rokusaburo.hailper/icons/proofread-26.png</value>
          </prop>
        </node>
      </node>
      <node oor:name="io.github.rokusaburo.hailper.image.custom" oor:op="replace">
        <prop oor:name="URL" oor:type="xs:string">
          <value>io.github.rokusaburo.hailper:custom</value>
        </prop>
        <node oor:name="UserDefinedImages">
          <prop oor:name="ImageSmallURL" oor:type="xs:string">
