        </node>
        <node oor:name="t_summarize" oor:op="replace">
          <prop oor:name="URL" oor:type="xs:string">
            <value>io.github.rokusaburo.hailper:summarize</value>
          </prop>
          <prop oor:name="Title" oor:type="xs:string">
            <value xml:lang="en-US">Summarize</value>
          </prop>
          <prop oor:name="Target" oor:type="xs:string">
            <value>_self</value>
          </prop>
        </node>
        <node oor:name="t_rewrite" oor:op="replace">
          <prop oor:name="URL" oor:type="xs:string">
            <value>io.github.rokusaburo.hailper:rewrite</value>
          </prop>
          <prop oor:name="Title" oor:type="xs:string">
            <value xml:lang="en-US">Rewrite / Improve…</value>
          </prop>
          <prop oor:name="Target" oor:type="xs:string">
            <value>_self</value>
          </prop>
        </node>
      </node>
    </node>

    <!-- ============= NotebookBar (Tabbed / Compact UI) ============= -->
    <node oor:name="OfficeNotebookBar">
      <node oor:name="*.OfficeNotebookBar" oor:op="replace">
        <node oor:name="nb_chat" oor:op="replace">
          <prop oor:name="URL" oor:type="xs:string">
            <value>io.github.rokusaburo.hailper:chat</value>
          </prop>
          <prop oor:name="Title" oor:type="xs:string">
            <value xml:lang="en-US">Chat with AI</value>
          </prop>
          <prop oor:name="Style" oor:type="xs:string">
            <value>icontext</value>
          </prop>
          <prop oor:name="Target" oor:type="xs:string">
            <value>_self</value>
          </prop>
        </node>
        <node oor:name="nb_summarize" oor:op="replace">
          <prop oor:name="URL" oor:type="xs:string">
            <value>io.github.rokusaburo.hailper:summarize</value>
          </prop>
          <prop oor:name="Title" oor:type="xs:string">
            <value xml:lang="en-US">Summarize</value>
          </prop>
          <prop oor:name="Style" oor:type="xs:string">
