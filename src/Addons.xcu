          <prop oor:name="Style" oor:type="xs:string">
            <value>icontext</value>
          </prop>
          <prop oor:name="Target" oor:type="xs:string">
            <value>_self</value>
          </prop>
        </node>
        <node oor:name="nb_translate" oor:op="replace">
          <prop oor:name="URL" oor:type="xs:string">
            <value>io.github.rokusaburo.hailper:translate</value>
          </prop>
          <prop oor:name="Title" oor:type="xs:string">
            <value xml:lang="en-US">Translate</value>
          </prop>
          <prop oor:name="Style" oor:type="xs:string">
            <value>icontext</value>
          </prop>
          <prop oor:name="Target" oor:type="xs:string">
            <value>_self</value>
          </prop>
        </node>
        <node oor:name="nb_proofread" oor:op="replace">
          <prop oor:name="URL" oor:type="xs:string">
            <value>io.github.rokusaburo.hailper:proofread</value>
          </prop>
          <prop oor:name="Title" oor:type="xs:string">
            <value xml:lang="en-US">Proofread</value>
          </prop>
          <prop oor:name="Style" oor:type="xs:string">
            <value>icontext</value>
          </prop>
          <prop oor:name="Target" oor:type="xs:string">
            <value>_self</value>
          </prop>
        </node>
        <node oor:name="nb_custom" oor:op="replace">
          <prop oor:name="URL" oor:type="xs:string">
            <value>io.github.rokusaburo.hailper:custom</value>
